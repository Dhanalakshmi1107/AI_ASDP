# AI_ASDP — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# ⚠️  If your real .env was ever committed to git, rotate every key in it now:
#      git log --all -- .env          (check if .env appears in history)
#      git log -p | grep -i "gsk_"   (check if Groq key was exposed)
#     Then use `git filter-repo` to purge and force-push.

# ---------------------------------------------------------------------------
# LLM providers (at least one required)
# ---------------------------------------------------------------------------

# Groq — free tier: ~14,400 req/day on Llama-3-70B
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini Flash — free tier: 1,500 req/day (separate quota from Groq)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# CVE data source
# ---------------------------------------------------------------------------

# "local" uses the bundled cve_fallback.json (no API calls needed)
# "nvd"   queries the NVD API — faster/more accurate but requires a key
#          Get yours at: https://nvd.nist.gov/developers/request-an-api-key
CVE_DATA_SOURCE=local
NVD_API_KEY=

# ---------------------------------------------------------------------------
# Security — authentication
# ---------------------------------------------------------------------------

# Set a strong random string to require X-API-Key header on all endpoints.
# Leave empty to run open (local / dev mode only).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ---------------------------------------------------------------------------
# CORS — allowed frontend origins
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the backend.
# Default (dev): localhost Vite server only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Allowed targets (optional — production gate)
# ---------------------------------------------------------------------------
# Absolute path to a plain-text file listing one allowed target per line.
# Leave empty to allow any target (dev/local use only).
# Example: ALLOWED_TARGETS_FILE=/etc/ai_asdp/allowed_targets.txt
ALLOWED_TARGETS_FILE=

# ---------------------------------------------------------------------------
# Flask server
# ---------------------------------------------------------------------------

# Set to "1" only when actively debugging locally — NEVER in production.
FLASK_DEBUG=0

# Bind address — use 127.0.0.1 (localhost only) unless behind a reverse proxy.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
